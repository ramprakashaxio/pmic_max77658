#include <zephyr/types.h>
#include <stddef.h>
#include <string.h>
#include <errno.h>
#include <zephyr/sys/byteorder.h>
#include <zephyr/sys/atomic.h>
#include <zephyr/sys/util.h>
#include <zephyr/kernel.h>
#include <zephyr/logging/log.h>
#include <zephyr/bluetooth/bluetooth.h>
#include <zephyr/bluetooth/hci.h>
#include <zephyr/bluetooth/conn.h>
#include <zephyr/bluetooth/uuid.h>
#include <zephyr/bluetooth/gatt.h>

#include "data_manager.h"
#include "storage_manager.h"
#include "max77658_main.h"
#include "ble_app.h"

LOG_MODULE_REGISTER(ble_app, LOG_LEVEL_INF);

/* --- UUIDs --- */
static struct bt_uuid_128 hope_svc_uuid = BT_UUID_INIT_128(
    BT_UUID_128_ENCODE(0x12345678, 0x1234, 0x5678, 0x1234, 0x56789abcdef0));

static struct bt_uuid_128 hope_data_uuid = BT_UUID_INIT_128(
    BT_UUID_128_ENCODE(0x12345678, 0x1234, 0x5678, 0x1234, 0x56789abcdef1));

static struct bt_uuid_128 char_profile_uuid = BT_UUID_INIT_128(
    BT_UUID_128_ENCODE(0x12345678, 0x1234, 0x5678, 0x1234, 0x56789abcdef5));

static struct bt_uuid_128 char_config_uuid = BT_UUID_INIT_128(
    BT_UUID_128_ENCODE(0x12345678, 0x1234, 0x5678, 0x1234, 0x56789abcdef6));

static struct bt_uuid_128 char_info_uuid = BT_UUID_INIT_128(
    BT_UUID_128_ENCODE(0x12345678, 0x1234, 0x5678, 0x1234, 0x56789abcdef7));

/* --- User structs --- */
typedef struct __attribute__((packed)) {
    uint8_t age;
    uint8_t height_cm;
    uint16_t weight_dg;
    uint8_t gender;
} user_profile_t;

typedef struct __attribute__((packed)) {
    uint8_t op_mode;
    uint16_t interval_s;
    uint8_t led_current;
} device_config_t;

/* --- MTU safe chunk packet (20 bytes) --- */
#define BLE_CHUNK_PAYLOAD 16
typedef struct __attribute__((packed)) {
    uint8_t batch_id;     /* seq LSB (helps app grouping) */
    uint8_t chunk_idx;
    uint8_t chunk_count;
    uint8_t rsvd;
    uint8_t data[BLE_CHUNK_PAYLOAD];
} ble_chunk_pkt_t;

/* Header to reconstruct a batch on phone */
typedef struct __attribute__((packed)) {
    uint8_t  ver;
    uint8_t  count;
    uint8_t  algo_mode;
    uint8_t  reserved0;
    uint32_t batch_seq;
    uint32_t uptime_ms;
} patient_batch_hdr_t;

/* Make sure our wire buffer is always big enough */
#define BLE_WIRE_MAX (sizeof(patient_batch_hdr_t) + ((size_t)BATCH_SIZE * sizeof(patient_sample_t)))
BUILD_ASSERT(BLE_WIRE_MAX <= 512, "Increase BLE_WIRE_MAX / reduce payload");

/* State */
static user_profile_t current_profile = {0};
static device_config_t current_config = {0, 0, 50};

static atomic_t g_ble_stop = ATOMIC_INIT(0);
static atomic_t g_force_flush = ATOMIC_INIT(0);
static atomic_t g_notify_enabled = ATOMIC_INIT(0);

K_SEM_DEFINE(bt_ready_sem, 0, 1);

/* Debug Helper */
static void log_batch_info(const char* prefix, const patient_batch_t *b) {
    LOG_INF("%s: Seq=%u Count=%d TS=%u", prefix, b->batch_seq, b->count, b->uptime_ms);
}

/* --- CCC for DATA characteristic only --- */
static void data_ccc_cfg_changed(const struct bt_gatt_attr *attr, uint16_t value)
{
    bool en = (value == BT_GATT_CCC_NOTIFY);
    atomic_set(&g_notify_enabled, en ? 1 : 0);
    LOG_INF("BLE Data Notifications: %s", en ? "ON" : "OFF");

    if (en) {
        atomic_set(&g_force_flush, 1); /* flush immediately on subscribe */
    }
}

/* --- R/W callbacks --- */
static ssize_t read_profile(struct bt_conn *conn, const struct bt_gatt_attr *attr,
                            void *buf, uint16_t len, uint16_t offset)
{
    return bt_gatt_attr_read(conn, attr, buf, len, offset,
                             &current_profile, sizeof(current_profile));
}

static ssize_t write_profile(struct bt_conn *conn, const struct bt_gatt_attr *attr,
                             const void *buf, uint16_t len, uint16_t offset, uint8_t flags)
{
    if (len != sizeof(user_profile_t)) {
        return BT_GATT_ERR(BT_ATT_ERR_INVALID_ATTRIBUTE_LEN);
    }
    memcpy(&current_profile, buf, len);
    return len;
}

static ssize_t read_config(struct bt_conn *conn, const struct bt_gatt_attr *attr,
                           void *buf, uint16_t len, uint16_t offset)
{
    return bt_gatt_attr_read(conn, attr, buf, len, offset,
                             &current_config, sizeof(current_config));
}

static ssize_t write_config(struct bt_conn *conn, const struct bt_gatt_attr *attr,
                            const void *buf, uint16_t len, uint16_t offset, uint8_t flags)
{
    if (len != sizeof(device_config_t)) {
        return BT_GATT_ERR(BT_ATT_ERR_INVALID_ATTRIBUTE_LEN);
    }
    memcpy(&current_config, buf, len);
    return len;
}

/* --- GATT service --- */
BT_GATT_SERVICE_DEFINE(hope_svc,
    BT_GATT_PRIMARY_SERVICE(&hope_svc_uuid),

    /* 1) Vitals stream (Notify) */
    BT_GATT_CHARACTERISTIC(&hope_data_uuid.uuid, BT_GATT_CHRC_NOTIFY,
                           BT_GATT_PERM_NONE, NULL, NULL, NULL),
    BT_GATT_CCC(data_ccc_cfg_changed, BT_GATT_PERM_READ | BT_GATT_PERM_WRITE),

    /* 5) User Profile (RW) */
    BT_GATT_CHARACTERISTIC(&char_profile_uuid.uuid,
                           BT_GATT_CHRC_READ | BT_GATT_CHRC_WRITE,
                           BT_GATT_PERM_READ | BT_GATT_PERM_WRITE,
                           read_profile, write_profile, NULL),

    /* 6) Device Config (RW) */
    BT_GATT_CHARACTERISTIC(&char_config_uuid.uuid,
                           BT_GATT_CHRC_READ | BT_GATT_CHRC_WRITE,
                           BT_GATT_PERM_READ | BT_GATT_PERM_WRITE,
                           read_config, write_config, NULL),

    /* 7) Device Info (Read only) - NO notify, no CCC */
    BT_GATT_CHARACTERISTIC(&char_info_uuid.uuid,
                           BT_GATT_CHRC_READ,
                           BT_GATT_PERM_READ,
                           NULL, NULL, NULL)
);

static const struct bt_data ad[] = {
    BT_DATA_BYTES(BT_DATA_FLAGS, (BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR)),
    BT_DATA(BT_DATA_NAME_COMPLETE, "Neso Monitor", 12),
};

static const struct bt_data sd[] = {
    BT_DATA_BYTES(BT_DATA_UUID128_ALL,
                  0xf0, 0xde, 0xbc, 0x9a, 0x78, 0x56, 0x34, 0x12,
                  0x78, 0x56, 0x34, 0x12, 0x78, 0x56, 0x34, 0x12),
};

static void bt_ready(int err)
{
    if (err) {
        LOG_ERR("BLE init failed (err %d)", err);
        return;
    }

    err = bt_le_adv_start(BT_LE_ADV_CONN, ad, ARRAY_SIZE(ad), sd, ARRAY_SIZE(sd));
    if (err) {
        LOG_ERR("Advertising failed (err %d)", err);
        return;
    }

    LOG_INF("Advertising started as 'Neso Monitor'");
    k_sem_give(&bt_ready_sem);
}

void ble_prepare_for_shutdown(void)
{
    atomic_set(&g_ble_stop, 1);
    atomic_set(&g_notify_enabled, 0);

    (void)bt_le_adv_stop();
    LOG_WRN("BLE: prepare_for_shutdown");
}

/* ------------------------------------------------ */
/* Ingest + Flush                                   */
/* ------------------------------------------------ */

/* * FLUSH INTERVAL
 * Must be less than storage capacity (20s) to avoid overwrite.
 * 10 seconds is a safe, responsive balance.
 */
#define BURST_INTERVAL_MS 10000  /* 10 Seconds */

static const struct bt_gatt_attr *hope_data_val_attr(void)
{
    /* Service attr layout: 0 svc, 1 char decl, 2 value, 3 CCC, ... */
    return &hope_svc.attrs[2];
}

/* Send one batch as MTU-safe 20-byte notifications */
static int ble_send_batch_stream(const patient_batch_t *b)
{
    uint8_t wire[BLE_WIRE_MAX];
    size_t payload_sz = sizeof(patient_batch_hdr_t) + ((size_t)b->count * sizeof(patient_sample_t));

    if (payload_sz > sizeof(wire)) {
        LOG_ERR("Wire buffer too small: payload=%u max=%u",
                (unsigned)payload_sz, (unsigned)sizeof(wire));
        return -EMSGSIZE;
    }

    patient_batch_hdr_t hdr = {
        .ver = b->ver,
        .count = b->count,
        .algo_mode = b->algo_mode,
        .reserved0 = 0,
        .batch_seq = b->batch_seq,
        .uptime_ms = b->uptime_ms
    };

    memcpy(wire, &hdr, sizeof(hdr));
    memcpy(wire + sizeof(hdr), b->samples, (size_t)b->count * sizeof(patient_sample_t));

    log_batch_info("TX START", b);

    /* Debug: Verify data is changing */
    LOG_INF("  PayloadSz=%u FirstBytes=%02x %02x %02x %02x", 
            (unsigned)payload_sz, 
            wire[0], wire[1], wire[2], wire[3]);

    uint8_t chunk_cnt = (uint8_t)((payload_sz + BLE_CHUNK_PAYLOAD - 1U) / BLE_CHUNK_PAYLOAD);

    for (uint8_t i = 0; i < chunk_cnt; i++) {
        ble_chunk_pkt_t pkt;
        memset(&pkt, 0, sizeof(pkt));

        pkt.batch_id = (uint8_t)(b->batch_seq & 0xFF);
        pkt.chunk_idx = i;
        pkt.chunk_count = chunk_cnt;

        size_t off = (size_t)i * BLE_CHUNK_PAYLOAD;
        size_t n = MIN((size_t)BLE_CHUNK_PAYLOAD, payload_sz - off);
        memcpy(pkt.data, wire + off, n);

        /* Debug first chunk only to avoid spam */
        if (i == 0) {
            LOG_DBG("  Chunk 0: ID=%u Len=%u", pkt.batch_id, (unsigned)n);
        }

        /* Retry on -ENOMEM (TX buffers full) */
        for (int tries = 0; tries < 20; tries++) {
            int err = bt_gatt_notify(NULL, hope_data_val_attr(), &pkt, sizeof(pkt));
            if (err == 0) break;

            if (err == -ENOMEM) {
                k_sleep(K_MSEC(20));
                continue;
            }
            return err;
        }

        k_sleep(K_MSEC(15)); /* pacing */
        if (atomic_get(&g_ble_stop)) return -EINTR;
        if (!atomic_get(&g_notify_enabled)) return -EACCES;
    }

    return 0;
}

static void ble_flush_loop(void)
{
    patient_batch_t b;
    int sent = 0;

    LOG_INF("BLE: Flush Loop Start. Pending in Flash: %d", storage_pending_count());

    while (atomic_get(&g_notify_enabled) && storage_has_data()) {
        if (atomic_get(&g_ble_stop)) break;

        if (storage_peek_next_batch(&b) != 0) {
            break;
        }

        log_batch_info("PEEKED (Flash->RAM)", &b);

        int err = ble_send_batch_stream(&b);
        if (err == 0) {
            (void)storage_drop_next_batch(); /* delete only on success */
            LOG_INF("DROPPED (Deleted from Flash) Seq=%u", b.batch_seq);
            sent++;
            /* CRITICAL: Yield to allow connection supervisor packets */
            k_sleep(K_MSEC(30));
        } else {
            LOG_WRN("Send failed (%d). Abort flush.", err);
            break;
        }

        k_yield();
    }

    LOG_INF("BLE: Flush Done. Sent %d. Remaining: %d", sent, storage_pending_count());
}

/* Ingest thread: ALWAYS save incoming data immediately */
/* Increased to 4096 to handle large patient_batch_t structs and NVS operations safely */
#define INGEST_STACK 4096
K_THREAD_STACK_DEFINE(ingest_stack, INGEST_STACK);
static struct k_thread ingest_thread;

static void ingest_fn(void *a, void *b, void *c)
{
    /* STATIC prevents stack overflow by moving this large struct to global RAM */
    static patient_batch_t in;

    while (1) {
        /* Blocking read copies data into 'in' */
        if (data_manager_get_ble_batch(&in) == 0) {
            log_batch_info("INGEST (RAM->Flash)", &in);
            int rc = storage_save_batch(&in);
            if (rc) {
                LOG_WRN("storage_save_batch failed: %d", rc);
            }
        }
    }
}

void start_ble_thread(void)
{
    if (storage_init() != 0) {
        LOG_ERR("Storage init failed. BLE buffering will not work.");
    }

    int err = bt_enable(bt_ready);
    if (err) {
        LOG_ERR("bt_enable failed: %d", err);
    } else {
        k_sem_take(&bt_ready_sem, K_FOREVER);
    }

    /* Start ingest at higher priority than flush, but below sensor thread */
    k_thread_create(&ingest_thread, ingest_stack, K_THREAD_STACK_SIZEOF(ingest_stack),
                    ingest_fn, NULL, NULL, NULL,
                    6 /* prio */, 0, K_NO_WAIT);
    k_thread_name_set(&ingest_thread, "ble_ingest");

    int64_t last_burst = k_uptime_get();

    while (1) {
        if (max77658_shutdown_requested() || atomic_get(&g_ble_stop)) {
            k_sleep(K_SECONDS(1));
            continue;
        }

        if (atomic_get(&g_notify_enabled)) {
            bool force = atomic_cas(&g_force_flush, 1, 0);
            int64_t now = k_uptime_get();

            if (force || (now - last_burst) >= BURST_INTERVAL_MS) {
                ble_flush_loop();
                last_burst = k_uptime_get();
            }

            k_sleep(K_SECONDS(1));
        } else {
            k_sleep(K_SECONDS(1));
        }
    }
}
